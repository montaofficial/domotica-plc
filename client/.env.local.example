# Cloudflare Access service token per l'app iOS (usato SOLO nella build nativa sul Mac).
#
# Copia questo file in ".env.local" e inserisci i valori reali del service token
# "domotica-app". Sul server li trovi in:  ~/deploy-package/cf-service-token.txt
#
# .env.local è git-ignored: il secret NON va mai committato, e non finisce nella
# build web pubblica (che non ha questo file).
VITE_CF_ACCESS_CLIENT_ID=
VITE_CF_ACCESS_CLIENT_SECRET=
